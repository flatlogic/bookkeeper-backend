{
  "name": "cp_for_web",
  "version": "2.0.0",
  "description": "CP for Web",
  "main": "dist/index.js",
  "scripts": {
    "migrate:run": "node dist/migrate.js run",
    "migrate:revert": "node dist/migrate.js revert",
    "test": "npm run build && node test/general-ledger.js && node test/session.js && node test/mail.js && node test/account-scope.js",
    "build": "tsc && npm run copy-templates",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e ts,ejs --exec npm run dev:start",
    "dev:start": "npm run build && npm start",
    "migrations:create": "typeorm migration:generate src/migrations/active/Migration -d ormconfig.js",
    "migrations:run": "node dist/migrate.js run",
    "heroku-postbuild": "npm install --production",
    "postinstall": "npm run build",
    "copy-templates": "node -e \"require('node:fs').cpSync('src/templates', 'dist/templates', { recursive: true })\""
  },
  "author": "Flatlogic LLC",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0",
    "npm": ">=8.11.0"
  },
  "dependencies": {
    "@types/bcrypt": "^3.0.0",
    "@types/cors": "^2.8.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.14.144",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.1",
    "@types/passport-jwt": "^3.0.2",
    "@types/pug": "2.0.10",
    "bcrypt": "6.0.0",
    "change-case": "^3.1.0",
    "class-validator": "0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "4.22.3",
    "express-validator": "6.15.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "moment": "^2.30.1",
    "nodemailer": "10.6.1",
    "object-mapper": "^6.0.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "^8.7.3",
    "pug": "3.0.4",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "nodemon": "3.1.11",
    "tslint": "^5.20.0"
  }
}
